flowchart LR
  subgraph KIT["Kit repo · shared by everyone"]
    direction TB
    kPlugin["`**plugins/loadout/**
    hooks · skills · MCP servers`"]
    kRules["`**rules/**
    how your agent uses the tools`"]
    kBase["`**settings.base.json**
    the keys loadout manages`"]
  end

  subgraph PER["Personal layer · your git repo"]
    direction TB
    pRules["`**rules/**
    me.md, your preferences`"]
    pSkills["`**skills/ · hooks/**`"]
    pSet["`**settings.json**
    your overrides`"]
    pMcp["`**mcp.json**
    your MCP servers`"]
  end

  merge{{"`**three-way merge**`"}}
  snap[("`**~/.claude/.loadout/**
  snapshot of the last merge`")]

  subgraph CC["Claude Code configuration"]
    direction TB
    cPlugin["`**~/.claude/plugins/**
    the loadout plugin`"]
    cRulesK["`**~/.claude/rules/loadout**`"]
    cRulesP["`**~/.claude/rules/personal**`"]
    cSkills["`**~/.claude/skills/**
    **~/.claude/hooks/personal/**`"]
    cSet["`**~/.claude/settings.json**`"]
    cMcp["`**~/.claude.json**
    user-scope MCP servers`"]
  end

  subgraph CX["Codex configuration"]
    direction TB
    xPlugin["`**codex plugin**
    the same plugins and marketplaces`"]
    xAgents["`**~/.codex/AGENTS.md**
    loadout's block: rules and me.md`"]
    xConf["`**~/.codex/config.toml**
    your MCP servers, effort, notifications`"]
    xSkills["`**~/.agents/skills/**`"]
  end

  kPlugin -. "Claude Code installs and auto-updates" .-> cPlugin
  kRules -- link --> cRulesK
  pRules -- link --> cRulesP
  pSkills -- link --> cSkills
  kBase e4@==> merge
  pSet e5@==> merge
  snap <-. "read, then rewrite" .-> merge
  merge e7@==> cSet
  pMcp -- "claude mcp add-json" --> cMcp
  kPlugin -. "loadout installs and refreshes" .-> xPlugin
  kRules -- "copied into the block" --> xAgents
  pRules -- "copied into the block" --> xAgents
  pSkills -- "link skills" --> xSkills
  pMcp -- "owned sections" --> xConf

  class kPlugin,kRules,kBase kit
  class pRules,pSkills,pSet,pMcp personal
  class cPlugin,cRulesK,cRulesP,cSkills,cSet,cMcp claude
  class merge engine
  class snap state
  class KIT kitGroup
  class PER personalGroup
  class CC claudeGroup
  class xPlugin,xAgents,xConf,xSkills codex
  class CX codexGroup
  class e4,e5,e7 emph
