---
config:
  look: neo
  layout: elk
  flowchart:
    curve: basis
    nodeSpacing: 24
    rankSpacing: 80
    wrappingWidth: 320
---
flowchart LR
  subgraph KIT["Kit repo · shared by everyone"]
    direction TB
    kPlugin["`**plugins/loadout/**
    hooks · skills · MCP servers`"]
    kRules["`**rules/**
    how your agent uses the tools`"]
    kBase["`**settings.base.json**
    the keys loadout manages`"]
    kProf["`**profiles/**
    per-repo add-ons`"]
  end

  subgraph PER["Personal layer · your git repo"]
    direction TB
    pRules["`**rules/**
    me.md and your other rules`"]
    pSkills["`**skills/ · hooks/**`"]
    pSet["`**settings.json**
    your overrides`"]
    pMcp["`**mcp.json**
    your MCP servers`"]
  end

  merge{{"`**three-way merge**`"}}
  snap[("`**~/.local/state/loadout/**
  snapshot of the last merge`")]

  subgraph CC["Claude Code configuration"]
    direction TB
    cPlugin["`**~/.claude/plugins/**
    the loadout plugin`"]
    cRulesK["`**~/.claude/rules/loadout**`"]
    cRulesP["`**~/.claude/rules/personal**`"]
    cSkills["`**~/.claude/skills/**
    **~/.claude/hooks/personal/**`"]
    cSet["`**~/.claude/settings.json**`"]
    cMcp["`**~/.claude.json**
    user-scope MCP servers`"]
  end

  subgraph CX["Codex configuration"]
    direction TB
    xPlugin["`**codex plugin**
    the same plugins and marketplaces`"]
    xAgents["`**~/.codex/AGENTS.md**
    loadout's block: kit and personal rules`"]
    xConf["`**~/.codex/config.toml**
    MCP servers, effort, notifications, plugin switches`"]
    xHooks["`**~/.codex/hooks.json**
    Serena's hooks`"]
    xSkills["`**~/.agents/skills/**`"]
  end

  serena{{"`**Serena's documented hooks**
  written by loadout`"}}

  vsc["`**VS Code extensions**
  Claude Code and Codex read the same folders`"]

  plan{{"`**repo writes**
  plan, yes, backup`"}}

  subgraph REPO["Your repo · its agents in .loadout.json"]
    direction TB
    rCfg["`**.loadout.json**
    agents, manage, the record`"]
    rFiles["`**.claude/ · .mcp.json · .codex/ · .agents/skills/**
    settings, MCP servers, skills`"]
  end

  kPlugin -. "Claude Code installs and auto-updates" .-> cPlugin
  kRules -- link --> cRulesK
  pRules -- link --> cRulesP
  pSkills -- link --> cSkills
  kBase e4@==> merge
  pSet e5@==> merge
  snap <-. "read, then rewrite" .-> merge
  merge e7@==> cSet
  pMcp -- "claude mcp add-json" --> cMcp
  kPlugin -. "loadout installs and refreshes (Codex CLI or extension codex)" .-> xPlugin
  serena -- "owned entries" --> xHooks
  kRules -- "copied into the block" --> xAgents
  pRules -- "copied into the block" --> xAgents
  pSkills -- "link skills" --> xSkills
  pMcp -- "owned sections" --> xConf
  pSet -- "effort, notifications" --> xConf
  vsc e16@-. reads .-> CC
  vsc e17@-. reads .-> CX
  kProf e18@==> plan
  plan e19@==> rFiles
  plan <-. "three-way against the record" .-> rCfg

  class kPlugin,kRules,kBase,kProf kit
  class pRules,pSkills,pSet,pMcp personal
  class cPlugin,cRulesK,cRulesP,cSkills,cSet,cMcp claude
  class merge,plan,serena engine
  class snap,vsc state
  class rCfg,rFiles local
  class KIT kitGroup
  class PER personalGroup
  class CC claudeGroup
  class xPlugin,xAgents,xConf,xHooks,xSkills codex
  class CX codexGroup
  class REPO engineGroup
  class e4,e5,e7,e18,e19 emph
  class e16,e17 muted
%% palette
