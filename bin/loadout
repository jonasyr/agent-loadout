#!/usr/bin/env python3
# Keep this file parseable by old Pythons: the version check must run before any newer syntax.
import sys


def require_python(version=None):
    version = version or sys.version_info
    if tuple(version[:2]) < (3, 11):
        sys.stderr.write("loadout needs Python 3.11 or newer (found %d.%d). Install it and re-run.\n" % (version[0], version[1]))
        sys.exit(1)


if __name__ == "__main__":
    require_python()
    from pathlib import Path

    sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "cli"))
    from loadout.__main__ import main  # noqa: E402

    sys.exit(main())
