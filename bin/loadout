#!/usr/bin/env python3
# Keep this file parseable by old Pythons: the version check must run before any newer syntax.
import sys


def reexec_with_uv(argv):
    """Started by a Python older than 3.11 (an old launcher still points at it): continue under a newer Python that
    uv knows, once. Written for old Pythons too."""
    import os
    import subprocess
    if os.environ.get("LOADOUT_REEXEC"):
        return
    name = "uv.exe" if os.name == "nt" else "uv"
    uv = None
    for folder in os.environ.get("PATH", "").split(os.pathsep):
        if folder and os.path.isabs(folder) and os.path.isfile(os.path.join(folder, name)):
            uv = os.path.join(folder, name)
            break
    if uv is None:
        return
    try:
        out = subprocess.Popen([uv, "python", "find", "--no-config", "--no-project", ">=3.11"], cwd=os.sep,
                               stdout=subprocess.PIPE, stderr=open(os.devnull, "w")).communicate()[0]
    except OSError:
        return
    lines = out.decode("utf-8", "replace").strip().splitlines()
    if lines and os.path.isfile(lines[0].strip()):
        os.environ["LOADOUT_REEXEC"] = "1"
        continue_under(lines[0].strip(), list(argv))


def continue_under(exe, argv, windows=None):
    """Run this script under exe. On Windows exec does not replace the process (the caller would see exit 0 at
    once and arguments with spaces split), so run it as a child and exit with its code."""
    import os
    import subprocess
    script = os.path.abspath(__file__)
    if windows if windows is not None else os.name == "nt":
        sys.exit(subprocess.call([exe, script] + list(argv)))
    os.execv(exe, [exe, script] + list(argv))


def require_python(version=None):
    version = version or sys.version_info
    if tuple(version[:2]) < (3, 11):
        reexec_with_uv(sys.argv[1:])  # returns only when uv has no newer Python
        sys.stderr.write("loadout needs Python 3.11 or newer (found %d.%d). Re-run bootstrap (it gets one through uv) "
                         "or install it yourself.\n" % (version[0], version[1]))
        sys.exit(1)


if __name__ == "__main__":
    require_python()
    from pathlib import Path

    sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "cli"))
    from loadout.__main__ import main  # noqa: E402

    sys.exit(main())
