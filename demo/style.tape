# The README demo's look, shared by loadout.tape and claude.tape.
Set Shell bash
Set FontFamily "JetBrains Mono"
Set FontSize 15
Set LineHeight 1.3
Set Width 1280
Set Height 800
Set Padding 28
Set Margin 36
Set MarginFill "#181a24"
Set BorderRadius 10
Set WindowBar Rings
Set Framerate 20
Set TypingSpeed 55ms
Set Theme { "name": "loadout", "background": "#0f1117", "foreground": "#e6e6eb", "cursor": "#a78bfa", "selection": "#2a2d3a", "black": "#1c1f2b", "red": "#f87171", "green": "#4ade80", "yellow": "#fbbf24", "blue": "#93c5fd", "purple": "#a78bfa", "magenta": "#a78bfa", "cyan": "#67e8f9", "white": "#d4d4dc", "brightBlack": "#6b7080", "brightRed": "#fca5a5", "brightGreen": "#86efac", "brightYellow": "#fde68a", "brightBlue": "#bfdbfe", "brightPurple": "#c4b5fd", "brightMagenta": "#c4b5fd", "brightCyan": "#a5f3fc", "brightWhite": "#ffffff" }
